# =========================================================
# CONFIGURACIÓN DE SUPABASE - LAYSLA COSMETICS
# =========================================================
# 1. Crea un proyecto gratuito en https://supabase.com
# 2. Ve a Configuración de Proyecto > API
# 3. Copia tu URL y tu Anon Public Key
# 4. Renombra este archivo a .env o crea un archivo .env con estos valores:

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# Credenciales de inicio para el Super Usuario Administrador por defecto:
VITE_ADMIN_EMAIL=admin@layslacosmetics.com
VITE_ADMIN_PASSWORD=layslaadmin2026
